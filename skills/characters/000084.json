      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription840031]",
          "descriptions": {
            "zh-CN": "篝火精神的帝国、极北之地的雪国、远在天边的地域、位于西方的军国、神灵栖息的森林……旅程中留下的无数轨迹，如今依旧历历在目——如果行动开始时身上附带「暴击率上升」状态，莉兹使自己增加20%攻击力，效果持续1回合（无法被解除）。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "篝火の帝国、極北の雪国、天涯の地、西の軍事国家、神宿りの森……。数多の旅路の軌跡は、今も鮮やかに――自身の行動開始時、自身が『クリティカル率増加』を付帯している場合、1ターンの間自身の攻撃力が20%増加する（解除不可）。"
          }
        },
        {
          "blessing_item_id": 0,

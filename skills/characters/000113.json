  "passive_skills": [
    {
      "id": 113003,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription1130031]",
          "descriptions": {
            "zh-CN": "活着的意义和理由都已消失，今后只用孤独地等待腐朽。然而，当女孩对她伸出小小的手时，鹭丝堤卡决定为了她再活一次，并期望有朝一日，自己也能带给某个人活下去的力量——行动结束时，鹭丝堤卡使自己与身上附带增益效果最多的其他友军，获得鹭丝堤卡攻击力×50%的「护盾」，效果持续8回合（无法被解除）。此技能须在结束8次行动后才可再次触发。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "生きる意味も理由も消え、あとは一人朽ちるのみ。だが、差し伸べられた小さな手に、もう一度生きる決意をした。そして願わくば、同じことを誰かに――自身の行動終了時、8ターンの間自身と自身以外の付帯しているバフの個数が最も多い味方に自身の攻撃力×50％の『シールド』を付与する（解除不可）。このスキルは発動後8回行動終了するまで再び発動しない。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[PassiveSkillDescription1130032]",
          "descriptions": {
            "zh-CN": "「护盾」值提升为鹭丝堤卡攻击力×75%。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "『シールド』の大きさが自身の攻撃力×75％になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription1130033]",
          "descriptions": {
            "zh-CN": "当「护盾」的附加目标为流金属性时，「护盾」值提升为鹭丝堤卡攻击力×150%。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "さらに『シールド』付与の対象が黄属性の場合、『シールド』の大きさが自身の攻撃力×150％になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 240,
          "description_key": "[PassiveSkillDescription1130034]",
          "descriptions": {
            "zh-CN": "强化青金缮补的红宝石，「护盾」值提升为鹭丝堤卡攻击力×400%。当附加目标为流金属性时，「护盾」值提升为鹭丝堤卡攻击力×800%。"
          },
          "equipment_rarity_flags": 256,
          "order": 4,
          "source_memo_ja": {
            "label": "Ex2",
            "text": "蒼金繕いのルベウスを強化する。『シールド』の大きさが自身の攻撃力×400%になる。対象が黄属性の場合、『シールド』の大きさが自身の攻撃力×800%になる。"
          }
        }
      ],

    {
      "id": 63004,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 61,
          "description_key": "[PassiveSkillDescription630041]",
          "descriptions": {
            "zh-CN": "我想成为温暖人心的灯火，而不是焚尽恶魔的烈火……战斗开始时，帕拉底亚获得3层「多重屏障」（无法被解除）。当她受到最大生命值×20%以上的伤害时，消耗1层屏障来抵消该伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "悪魔を焼き尽くす炎ではなく、誰かの心に温もりを与える、そんな灯火になりたかった……。バトル開始時自身に3層の『多重バリア』を付与する（解除不可）。自身の最大HP×20%以上のダメージを受けると、バリアを1層消費してそのダメージを無効化する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 141,
          "description_key": "[PassiveSkillDescription630042]",
          "descriptions": {
            "zh-CN": "帕拉底亚在同一波攻击中每暴击2次，使攻击力最高的幽冥属性友军获得1层「多重屏障」（最多叠加2层）（无法被解除）。当技能目标受到最大生命值×10%以上的伤害时，消耗1层屏障来抵消该伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "さらに自身が攻撃して、クリティカルヒットした場合、その攻撃内でクリティカルヒットした回数2回につき冥属性のうち攻撃力が最も高い味方に1層の『多重バリア』を付与する（最大2層まで）（解除不可）。自身の最大HP×10%以上のダメージを受けると、バリアを1層消費してそのダメージを無効化する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 221,
          "description_key": "[PassiveSkillDescription630043]",
          "descriptions": {
            "zh-CN": "帕拉底亚攻击暴击时的「多重屏障」附加目标增加为攻击力最高的3名幽冥属性友军。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "自身が攻撃してクリティカルヒットした場合に『多重バリア』を付与する対象が冥属性のうち攻撃力が高い味方3体になる。"
          }
        },

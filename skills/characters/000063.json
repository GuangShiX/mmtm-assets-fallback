  "passive_skills": [
    {
      "id": 63003,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 11,
          "description_key": "[PassiveSkillDescription630031]",
          "descriptions": {
            "zh-CN": "“用你的力量拯救世界吧，直到这股力量将世界毁灭。”每当听见恶魔的低语，她的心便逐渐染上浓重的黑影……当攻击暴击时，帕拉底亚获得1层增益效果，使自己增加1%暴击率（无法被解除）。每次暴击使增益效果的叠加数增加1层（最多20层）。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "「その力で世界を守るといい。その力で世界を滅ぼすまで」囁く声が聞こえるたびに、心が黒く染まっていく……。自身が攻撃して、クリティカルヒットした場合、自身にクリティカル率が1％増加するバフを付与する（解除不可）。クリティカルヒットした回数1回につきスタック数が1増加する（最大20回まで）。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 101,
          "description_key": "[PassiveSkillDescription630032]",
          "descriptions": {
            "zh-CN": "技能触发条件增加为帕拉底亚或友军的攻击暴击。友军每次暴击使增益效果的叠加数增加1层。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "このスキルが味方が攻撃してクリティカルヒットした場合にも発動するようになる。味方が攻撃してクリティカルヒットした回数1回につきスタック数が1増加する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription630033]",
          "descriptions": {
            "zh-CN": "暴击率增幅提升为2%，增幅上限提升为40%。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "クリティカル率の増加量が2%になり、増加量最大値が40%になる。自身か味方が攻撃してクリティカルヒットした回数1回につきスタック数が1増加する。"
          }
        }
      ],

    {
      "conditions": "True",
      "id": 63002,
      "initial_cooldown": 0,
      "kind": "active",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 21,
          "description_key": "[ActiveSkillDescription630021]",
          "descriptions": {
            "zh-CN": "“如果我还有用处的话……！”帕拉底亚随机对敌人进行4次攻击，每次造成攻击力×480%的物理伤害。“我并不想要这股力量，但我愿意用它来保护大家……！”发动攻击前，如果帕拉底亚身上附带正义魔女附加的「暴击率上升」状态，且叠加数为20层以上时，则消耗所有层数发动技能漆黑弹雨。［漆黑弹雨］随机对敌人进行4次攻击，每次造成攻击力×960%的物理伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "「こんな私でも、まだお役に立てるなら……！」ランダムな敵に4回攻撃力×480%の物理攻撃を行う。「望まない力だとしても、皆を守れるなら、私は……！」物理攻撃の前に自身が正義の魔女で付与した『クリティカル率増加』のスタック数が20以上の場合、スタック数を0にしてバレットストームの代わりにブラックバレットを発動する。[ブラックバレット]ランダムな敵に4回攻撃力×960%の物理攻撃を行う。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[ActiveSkillDescription630022]",
          "descriptions": {
            "zh-CN": "强化漆黑弹雨，此攻击必定暴击。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "ブラックバレットを強化する。必ずクリティカルヒットするようになる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[ActiveSkillDescription630023]",
          "descriptions": {
            "zh-CN": "强化漆黑弹雨，发动攻击前额外解除技能目标身上的2种增益效果（只对每名目标进行1次弱化效果命中与否的判定）。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "ブラックバレットを強化する。さらに物理攻撃の前に対象のバフを2つ解除するようになる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 181,
          "description_key": "[ActiveSkillDescription630024]",
          "descriptions": {
            "zh-CN": "弹雨风暴造成的物理伤害提升为攻击力×880%，漆黑弹雨造成的物理伤害提升为攻击力×1760%。"
          },
          "equipment_rarity_flags": 0,
          "order": 4,
          "source_memo_ja": {
            "label": "Lv4",
            "text": "バレットストームの物理攻撃のダメージが攻撃力×880%になり、ブラックバレットの物理攻撃のダメージが攻撃力×1760%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 240,
          "description_key": "[ActiveSkillDescription630025]",
          "descriptions": {
            "zh-CN": "强化弹雨风暴与漆黑弹雨，弹雨风暴造成的物理伤害提升为攻击力×980%，漆黑弹雨造成的物理伤害提升为攻击力×1960%。"
          },
          "equipment_rarity_flags": 512,
          "order": 5,
          "source_memo_ja": {
            "label": "Ex3",
            "text": "バレットストームとブラックバレットを強化する。バレットストームの物理攻撃のダメージが攻撃力×980%になり、ブラックバレットの物理攻撃のダメージが攻撃力×1960%になる。"
          }
        }
      ],

  "passive_skills": [
    {
      "id": 126003,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription1260031]",
          "descriptions": {
            "zh-CN": "“哈哈哈！吾乃火灵之子，米赫里是也！汝等还不速速退散！　……这段开场白，以后可以不说了吗？”行动开始时，米赫里获得1层「阳焰灯火」（最多15层）（无法被解除）。每层「阳焰灯火」使附带者增加5%攻击力。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "「ふはは！　おそれおののけ！　我こそが炎の申し子、ミフリなり！　……この口上、もう辞めていい……？」自身の行動開始時、自身に『陽炎の灯』を1スタック付与する（最大15スタックまで）（解除不可）。このバフは1スタックにつき付帯者の攻撃力を5%増加させる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[PassiveSkillDescription1260032]",
          "descriptions": {
            "zh-CN": "如果场上有身上附带4种以上增益效果的友军，获得的「阳焰灯火」层数增加为2层。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "さらにバフを4つ以上付帯している味方がいる場合、『陽炎の灯』の付与スタック数が2になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription1260033]",
          "descriptions": {
            "zh-CN": "「阳焰灯火」的附加目标增加为米赫里与攻击力最高的其他友军。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "『陽炎の灯』を付与する対象が自身と自身以外の攻撃力が最も高い味方になる。"
          }
        }
      ],

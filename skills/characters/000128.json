      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 1,
          "description_key": "[ActiveSkillDescription1280011]",
          "descriptions": {
            "zh-CN": "“糯糯，咱们上！”利伯瑞娅与好搭档一同向敌人发动突袭——随机对敌人进行5次攻击，每次造成攻击力×180%的物理伤害。发动攻击前，70%概率对技能目标附加1层「沙尘」，效果持续2回合（最多4层）。每层「沙尘」使附带者增加5%承受伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "「行くぞ、モチモチ！」相棒と共に敵に突撃──ランダムな敵に5回攻撃力×180%の物理攻撃を行う。物理攻撃の前に70%の確率で2ターンの間対象に『砂塵』を1スタック付与する（最大4スタックまで）。この弱体効果は1スタックにつき付帯者の被ダメージを5%増加させる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 81,
          "description_key": "[ActiveSkillDescription1280012]",
          "descriptions": {
            "zh-CN": "「沙尘」附加判定结束后，如果技能目标的生命值为70%以上，「沙尘」的叠加数额外增加1层。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "さらに『砂塵』付与の判定の後、対象のHP割合が70%以上の場合、対象の『砂塵』のスタック数を1増加させる（対象が『砂塵』を付帯していない場合発動しない）。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription1280013]",
          "descriptions": {
            "zh-CN": "造成的物理伤害提升为攻击力×480%。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "物理攻撃のダメージが攻撃力×480%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription1280014]",
          "descriptions": {
            "zh-CN": "强化沙尘猛袭，攻击次数增加为8次。"
          },
          "equipment_rarity_flags": 128,
          "order": 4,
          "source_memo_ja": {
            "label": "Ex1",
            "text": "砂塵の猛攻を強化する。物理攻撃の回数が8回になる。"
          }
        }
      ],

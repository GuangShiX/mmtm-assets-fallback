      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription590031]",
          "descriptions": {
            "zh-CN": "下手要又快又准，不让虚弱的猎物受太多苦——这是祖父传授给埃尔的猎人守则。当身上附带控制效果的敌人为1名以上时，埃尔在每回合开始时使自己增加15%速度与30%攻击力，效果持续1回合（无法被解除）。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "弱った獲物は、苦しませず、速やかにとどめを刺す。それが祖父から受け継いだ狩人の矜持。毎ターン開始時、行動阻害効果を付帯している敵が1体以上いる場合、1ターンの間自身のスピードが15％、攻撃力が30％増加する（解除不可）。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[PassiveSkillDescription590032]",
          "descriptions": {
            "zh-CN": "每回合开始时，如果身上附带控制效果的敌人数为0，埃尔额外获得攻击力×500%的「护盾」，效果持续1回合（无法被解除）。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "毎ターン開始時、さらに行動阻害効果を付帯している敵がいない場合、自身に1ターンの間自身の攻撃力×500％の『シールド』を付与する（解除不可）。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription590033]",
          "descriptions": {
            "zh-CN": "速度增幅提升为30%，攻击力增幅提升为60%。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "スピードの増加量が30％、攻撃力の増加量が60％になる。"
          }
        }
      ],

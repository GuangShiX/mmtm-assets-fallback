    {
      "id": 90004,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 61,
          "description_key": "[PassiveSkillDescription900041]",
          "descriptions": {
            "zh-CN": "“这个世界上还有东西待我探明，所以我现在不能死。除此之外还需要什么理由吗？”回合开始时，嘉德利亚获得状态效果生效前的最大生命值×50%的「护盾」，效果持续4回合。此技能须在结束4次行动后才可再次触发。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "「この世界には、私が解き明かすべきものが残っている。それ以外に倒れない理由がいるかね？」ターン開始時、4ターンの間自身にステータス増減前の自身の最大HP×50%の『シールド』を付与する。このスキルは発動後4回行動終了するまで再び発動しない。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 141,
          "description_key": "[PassiveSkillDescription900042]",
          "descriptions": {
            "zh-CN": "战斗开始时，嘉德利亚额外减少60%自身承受伤害（无法被解除）。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "さらにバトル開始時、自身の被ダメージが60%減少する（解除不可）。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 221,
          "description_key": "[PassiveSkillDescription900043]",
          "descriptions": {
            "zh-CN": "回合开始时，使自己额外增加150%防御力，效果持续4回合。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "ターン開始時、さらに4ターンの間自身の防御力が150%増加する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 240,
          "description_key": "[PassiveSkillDescription900044]",
          "descriptions": {
            "zh-CN": "强化对未知的渴望，「护盾」值提升为状态效果生效前的嘉德利亚最大生命值×200%。"
          },
          "equipment_rarity_flags": 256,
          "order": 4,
          "source_memo_ja": {
            "label": "Ex2",
            "text": "未知への渇望を強化する。『シールド』の大きさがステータス増減前の自身の最大HP×200%になる。"
          }
        }
      ],

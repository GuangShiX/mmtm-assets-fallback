      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 1,
          "description_key": "[ActiveSkillDescription900011]",
          "descriptions": {
            "zh-CN": "力量解放条件随着嘉德利亚每次挥鞭逐渐达成——嘉德利亚使自己增加20%攻击力，效果持续4回合。再随机对敌人进行2次攻击，每次造成攻击力×360%的物理伤害。挥鞭达到一定次数后，原有的力量将破土而出——战斗中自第2次发动此技能起，攻击力增幅提升为40%。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "鞭は振るわれるたびに力の解放条件を積み上げていく──4ターンの間自身の攻撃力が20%増加する。その後ランダムな敵に2回攻撃力×360%の物理攻撃を行う。回数を重ねると、やがて本来の力を芽吹かせる──バトル中このスキルを発動するのが2回目以降の場合、攻撃力の増加量が40%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 81,
          "description_key": "[ActiveSkillDescription900012]",
          "descriptions": {
            "zh-CN": "攻击次数增加为4次。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "物理攻撃の回数が4回になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription900013]",
          "descriptions": {
            "zh-CN": "造成的物理伤害提升为攻击力×590%。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "物理攻撃のダメージが攻撃力×590%になる。"
          }
        },
        {

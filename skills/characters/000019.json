    {
      "id": 19004,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 61,
          "description_key": "[PassiveSkillDescription190041]",
          "descriptions": {
            "zh-CN": "死亡的气息使复仇之火燃烧得更加猛烈，再多的痛苦都会在这股灼热中化为灰烬。当贝尔在生命值低于50%时受到攻击，承受伤害超过最大生命值的30%时，阻绝超量部分×100%的伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "死の気配がした時、報復の炎はより強く燃え上がる。その熱は痛みすら焼き消す。自身のHP割合が50％未満で、攻撃を受けた場合、ダメージが自身の最大HPの30％を超えない。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 141,
          "description_key": "[PassiveSkillDescription190042]",
          "descriptions": {
            "zh-CN": "当贝尔受到攻击，生命值低于50%时，额外将超过贝尔最大生命值×30%的总伤害量转化为「护盾」，效果持续3回合。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "さらに自身が攻撃を受けて、HP割合が50％未満になった場合、3ターンの間自身に自身の最大HP×30％を超えたダメージ×100％の『シールド』を付与する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 221,
          "description_key": "[PassiveSkillDescription190043]",
          "descriptions": {
            "zh-CN": "阻绝量提升为超过贝尔最大生命值×20%的伤害量，「护盾」值提升为超过贝尔最大生命值×20%的总伤害量。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "ダメージの上限が最大HP×20％、『シールド』の大きさが自身の最大HP×20％を超えたダメージ×100％になる。"
          }
        }
      ],

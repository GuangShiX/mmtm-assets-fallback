    {
      "conditions": "True",
      "id": 19001,
      "initial_cooldown": 0,
      "kind": "active",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 1,
          "description_key": "[ActiveSkillDescription190011]",
          "descriptions": {
            "zh-CN": "从最强的家伙开始烧光。贝尔用法杖释放烈焰，对攻击力最高的敌人进行4次攻击，每次造成攻击力×340%的魔法伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "強い奴から焼き尽くす。杖から噴き出した激しい炎が、攻撃力が最も高い敵に4回攻撃力×340%の魔法攻撃を行う。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 81,
          "description_key": "[ActiveSkillDescription190012]",
          "descriptions": {
            "zh-CN": "当技能目标的生命值高于50%时，额外附加「流血」状态，效果持续2回合，每回合行动开始时造成贝尔攻击力×10%的伤害；当技能目标的生命值为50%以下时，额外解除技能目标身上的1种增益效果。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "さらに対象のHP割合が50％より大きい場合、2ターンの間『出血』を付与する。毎ターン行動開始時に自身の攻撃力×10％のダメージを与える。対象のHP割合が50％以下の場合、バフを1つ解除する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription190013]",
          "descriptions": {
            "zh-CN": "造成的魔法伤害提升为攻击力×420%。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "魔法攻撃のダメージが攻撃力×420%になる。　/専用1 バーストエンドを強化する。さらに魔法攻撃の前に2ターンの間自身のクリティカル耐性率が50%増加する。　/専用2 バーストエンドを強化する。魔法攻撃の回数が5回になる。　/専用3 バーストエンドを強化する。『出血』のターン数が4ターンになる。"
          }
        },
        {

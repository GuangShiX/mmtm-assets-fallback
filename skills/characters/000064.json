      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 1,
          "description_key": "[ActiveSkillDescription640011]",
          "descriptions": {
            "zh-CN": "吉薇艾尔以魔法造出一片苍茫暮色，迷惑敌人心智并夺走对手的力量——解除攻击力最高的2名敌人身上的1种增益效果。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "魔法で生み出された夕闇が敵を惑わし力を奪う――攻撃力が高い敵2体のバフを1つ解除する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 81,
          "description_key": "[ActiveSkillDescription640012]",
          "descriptions": {
            "zh-CN": "增益效果解除后，如果技能目标的生命值为50%以上，20%概率额外附加「沉默」状态，效果持续1回合。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "さらにバフ解除後に対象のHP割合が50%以上の場合、20%の確率で1ターンの間対象に『沈黙』を付与する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription640013]",
          "descriptions": {
            "zh-CN": "增益效果解除后，如果技能目标的魔力低于自己，附加「沉默」状态的概率提升为40%。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "バフ解除後に対象の魔力が自身よりも低い場合、『沈黙』を付与する確率が40%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription640014]",
          "descriptions": {
            "zh-CN": "强化幻惑暮霭，附加「沉默」状态的概率提升为30%。当技能目标的魔力低于自己时，附加「沉默」状态的概率提升为60%。"
          },
          "equipment_rarity_flags": 128,
          "order": 4,
          "source_memo_ja": {
            "label": "Ex1",
            "text": "惑いの夕闇を強化する。『沈黙』を付与する確率が30%、対象の魔力が自身よりも低い場合60%になる。"
          }
        }
      ],

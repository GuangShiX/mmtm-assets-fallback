          "character_level": 1,
          "description_key": "[ActiveSkillDescription1480011]",
          "descriptions": {
            "zh-CN": "桂妮维亚以温柔的心真挚地包容一切，使自己受到2次当前生命值×20%的自损伤害，随机对敌人进行5次攻击，每次造成攻击力×280%的物理伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "やわらかな心で優しく包み込む。自身に2回自身の現在HP×20%の自傷ダメージを与え、ランダムな敵に5回攻撃力×280%の物理攻撃を行う。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 81,
          "description_key": "[ActiveSkillDescription1480012]",
          "descriptions": {
            "zh-CN": "发动攻击前，70%概率使技能目标额外增加10%承受伤害，效果持续2回合。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "さらに物理攻撃の前に70%の確率で2ターンの間対象の被ダメージを10%増加させる。"
          }
        },
        {
          "blessing_item_id": 0,

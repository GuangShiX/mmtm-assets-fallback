  "passive_skills": [
    {
      "id": 65003,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription650031]",
          "descriptions": {
            "zh-CN": "哀音弹奏的旋律，道尽她想守护家乡的纯粹心意——回合开始时，哀音使自己与攻击力最高的2名其他友军获得技能目标专长能力数值×100%的「护盾」，效果持续3回合（无法被解除）。当技能目标身上附带此技能附加的「护盾」时，增加60%抗暴率。此技能须在结束4次行动后才可再次触发。当技能目标身上附带此技能附加的增益效果时，重复附加的新效果将直接取代旧效果。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "旋律に込めた想いは、守りたいと願う無垢な心──ターン開始時、3ターンの間自身と自身以外の攻撃力が高い味方2体に対象のタイプステータス×100％の『シールド』を付与する（解除不可）。このスキルで付与した『シールド』を付帯している間、付帯者のクリティカル耐性率が60％増加する。このスキルは4ターンに1回発動する。対象がこのスキルで付与したバフを付帯している場合、効果は新しい値に上書きされる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[PassiveSkillDescription650032]",
          "descriptions": {
            "zh-CN": "「护盾」值提升为技能目标专长能力数值×200%。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "『シールド』の大きさが対象のタイプステータス×200％になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription650033]",
          "descriptions": {
            "zh-CN": "回合开始时，「恶魔的引诱」每减少1层，使「护盾」值额外提升技能目标专长能力数值×20%（合计最多400%）。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "さらにターン開始時の『悪魔の誘い』のスタック減少数1につき、『シールド』の大きさが対象のタイプステータス×20％大きくなる（合計で最大400％まで）。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 240,
          "description_key": "[PassiveSkillDescription650034]",
          "descriptions": {
            "zh-CN": "强化心愿的旋律，哀音获得的「护盾」值提升为专长能力数值×1500%（合计最多1700%），攻击力最高的2名其他友军获得的「护盾」值提升为专长能力数值×300%（合计最多500%）。此技能须在结束1次行动后才可再次触发。"
          },
          "equipment_rarity_flags": 256,
          "order": 4,
          "source_memo_ja": {
            "label": "Ex2",
            "text": "夢の旋律を強化する。自身の『シールド』の大きさが対象のタイプステータス×1500％になり（合計で最大1700％まで）、自身以外の攻撃力が高い味方2体の『シールド』の大きさが対象のタイプステータス×300％になる（合計で最大500％まで）。さらにこのスキルが毎ターン開始時に発動するようになる。"
          }
        }
      ],

      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 1,
          "description_key": "[ActiveSkillDescription420011]",
          "descriptions": {
            "zh-CN": "福尔蒂娜虔诚祈求同伴平安的心，使全体友军获得福尔蒂娜攻击力×120%的「护盾」与「再生」状态，效果持续1回合，每回合行动开始时恢复福尔蒂娜最大生命值×7%的生命值。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "仲間の無事を願い、一心に祈る心が、味方全体に1ターンの間自身の攻撃力×120%の『シールド』と『再生』を付与する。毎ターン行動開始時に付帯者のHPを付与者の最大HP×7%回復する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 81,
          "description_key": "[ActiveSkillDescription420012]",
          "descriptions": {
            "zh-CN": "「护盾」值提升为福尔蒂娜攻击力×150%。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "『シールド』の大きさが自身の攻撃力×150%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription420013]",
          "descriptions": {
            "zh-CN": "「护盾」与「再生」效果增加为3回合。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "『シールド』と『再生』のターン数がそれぞれ3ターンになる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription420014]",
          "descriptions": {
            "zh-CN": "强化圣女的祈祷，「护盾」值提升为福尔蒂娜攻击力×400%。战斗中前2次发动此技能时，福尔蒂娜获得的「护盾」值提升为福尔蒂娜攻击力×600%。"
          },
          "equipment_rarity_flags": 128,
          "order": 4,
          "source_memo_ja": {
            "label": "Ex1",
            "text": "聖女の祈りを強化する。『シールド』の大きさが自身の攻撃力×400%になる。バトル中このスキルを発動するのが2回目以前の場合、自身に付与する『シールド』の大きさが自身の攻撃力×600%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 240,
          "description_key": "[ActiveSkillDescription420015]",
          "descriptions": {
            "zh-CN": "强化圣女的祈祷，「护盾」值提升为福尔蒂娜攻击力×440%。战斗中前2次发动此技能时，福尔蒂娜获得的「护盾」值提升为福尔蒂娜攻击力×660%。"
          },
          "equipment_rarity_flags": 512,
          "order": 5,
          "source_memo_ja": {

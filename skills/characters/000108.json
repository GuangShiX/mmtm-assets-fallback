  "passive_skills": [
    {
      "id": 108003,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription1080031]",
          "descriptions": {
            "zh-CN": "一直以来，因为有你在我身边，我才能每天都保持笑容。谢谢索索，我也最喜欢你了。回合开始时，露娜琳德使速度最高的友军获得1层「多重屏障」（无法被解除）。当技能目标受到伤害时，消耗1层屏障来抵消该伤害。此技能须在结束8次行动后才可再次触发。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "あなたが隣に居てくれるから、私はいつも笑顔になれる。ありがとう。私もあなたが大好きよ。ターン開始時スピードが最も高い味方に1層の『多重バリア』を付与する（解除不可）。ダメージを受けると、バリアを1層消費してそのダメージを無効化する。このスキルは発動後8回行動終了するまで再び発動しない。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[PassiveSkillDescription1080032]",
          "descriptions": {
            "zh-CN": "当「多重屏障」的附加目标为业红或苍翠属性时，「多重屏障」增加为2层。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "さらに『多重バリア』を付与する対象が紅属性もしくは翠属性の場合、付与する『多重バリア』が2層になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription1080033]",
          "descriptions": {
            "zh-CN": "当「多重屏障」的附加目标为业红或苍翠属性时，「多重屏障」增加为4层。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "『多重バリア』を付与する対象が紅属性もしくは翠属性の場合に付与する『多重バリア』が4層になる。"
          }
        }
      ],

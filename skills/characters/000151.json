    {
      "id": 151004,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 61,
          "description_key": "[PassiveSkillDescription1510041]",
          "descriptions": {
            "zh-CN": "彼此守护，彼此信赖——我想和你结下这种全新的情谊。所以，也让我来保护你吧。第1回合行动开始时，福尔蒂娜获得「献身」状态，代其他友军承受50%攻击伤害，效果持续3回合（无法被解除）。如果福尔蒂娜在身上附带此技能附加的「献身」状态时受到攻击，阻绝40%伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "護り護られ、信じて頼る。そんな新しい関係でいたい。だから私にもあなたを護らせて──1ターン目の自身の行動開始時、自身に3ターンの間『献身』を付与する（解除不可）。自身以外の味方が受けるダメージ×50%を自身が代わりに受けるようになる。自身がこのスキルで付与した『献身』を付帯している間、自身が攻撃を受けたとき、ダメージを40%遮断する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 141,
          "description_key": "[PassiveSkillDescription1510042]",
          "descriptions": {
            "zh-CN": "「献身」存在期间，伤害阻绝量提升为50%。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "『献身』を付帯している間のダメージの遮断量が50%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 221,

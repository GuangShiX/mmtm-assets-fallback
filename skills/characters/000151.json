      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription1510031]",
          "descriptions": {
            "zh-CN": "请让我的心，长伴在你左右。纵使彼此分离，两心仍能相依——战斗开始时，如果队伍中包含的角色属性为2种以下，福尔蒂娜使全体友军增加10%速度（无法被解除）。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "私の心を、どうかあなたの傍において。遠く離れていても、あなたの心に寄り添えるように──バトル開始時、味方編成内の属性が2種類以下の場合、味方全体のスピードを10%増加させる（解除不可）。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[PassiveSkillDescription1510032]",
          "descriptions": {
            "zh-CN": "第2回合开始时，福尔蒂娜使自己与攻击力最高的2名其他友军额外增加攻击力，增幅为福尔蒂娜攻击力×15%，效果持续3回合（无法被解除）。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "さらに2ターン目のターン開始時、3ターンの間自身と自身以外の攻撃力が高い味方2体の攻撃力を、自身の攻撃力×15%増加させる（解除不可）。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription1510033]",
          "descriptions": {
            "zh-CN": "攻击力增幅提升为福尔蒂娜攻击力×30%。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "攻撃力の増加量が自身の攻撃力×30%になる。"
          }
        }

      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 61,
          "description_key": "[PassiveSkillDescription690041]",
          "descriptions": {
            "zh-CN": "高贵而美丽的月亮，在深沉的夜色中愈发皎洁——当辉夜被附加主动技能造成的弱化效果时，70%概率对附加弱化效果的敌人附加1种弱化效果，减少25%物魔防御穿透与10%攻击力，效果持续4回合。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "気高くも美しい月は、夜が濃いほどに輝く──自身がアクティブスキルで弱体効果を受けたとき、70%の確率で4ターンの間弱体効果を付与してきた敵の物魔防御貫通を25%、攻撃力を10%減少させる。これらは一つの弱体効果として扱う。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 141,
          "description_key": "[PassiveSkillDescription690042]",
          "descriptions": {
            "zh-CN": "战斗开始时，辉夜额外减少40%自身承受伤害（无法被解除）。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,

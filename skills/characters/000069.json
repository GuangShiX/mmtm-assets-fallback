      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 1,
          "description_key": "[ActiveSkillDescription690011]",
          "descriptions": {
            "zh-CN": "“为妾身鞠躬尽瘁罢。”如梦似幻的迷雾间亮起月光，洒落在友军身上，使全体友军增加20%暴击率，效果持续2回合。美如幻境的景象摄人心魄，随后化为噩梦扑面而来，随机对5名敌人造成攻击力×280%的魔法伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "「妾のために励むのじゃ」夢幻の霧から生まれし月光が味方に降り注ぎ、2ターンの間味方全体のクリティカル率を20%増加させる。夢のような美しい風景に心を奪われた時、幻が悪夢となって襲いかかる。その後ランダムな敵5体に攻撃力×280%の魔法攻撃を行う。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 81,
          "description_key": "[ActiveSkillDescription690012]",
          "descriptions": {
            "zh-CN": "发动攻击前使全体友军额外增加20%暴击伤害强化，效果持续2回合。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "さらに魔法攻撃の前に2ターンの間味方全体のクリティカルダメージを20%増加させる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription690013]",
          "descriptions": {
            "zh-CN": "造成的魔法伤害提升为攻击力×380%。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "魔法攻撃のダメージが攻撃力×380%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription690014]",
          "descriptions": {
            "zh-CN": "强化镜花水月，「暴击率上升」与「暴击伤害强化上升」效果增加为4回合。"
          },
          "equipment_rarity_flags": 128,
          "order": 4,
          "source_memo_ja": {
            "label": "Ex1",
            "text": "鏡花水月を強化する。『クリティカル率増加』と『クリティカルダメージ増加』のターン数がそれぞれ4ターンになる。"
          }
        }
      ],

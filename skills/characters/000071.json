          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "\\nさらに攻撃してきた敵が『毒』を付帯している場合、ダメージを50%遮断する。"
          }
        },

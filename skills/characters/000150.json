    {
      "id": 150004,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 61,
          "description_key": "[PassiveSkillDescription1500041]",
          "descriptions": {
            "zh-CN": "誓言是约束自己的戒律。只要你仍相信着我，这颗心、这份誓言，便永远不会动摇——战斗开始时，佛罗伦斯强化自己的普通攻击，效果持续10回合。普攻时随机对5名敌人造成攻击力×390%的物理伤害，再使生命值百分比最低的3名友军恢复10%最大生命值。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "誓いは自分への戒め。もうこの心が、誓いが揺らぐことはない。君が信じてくれている限り──バトル開始時、10ターンの間自身の通常攻撃を強化する。通常攻撃時、ランダムな敵5体に攻撃力×390%の物理攻撃を行い、HP割合が低い味方3体のHPを対象の最大HP×10%回復する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 141,
          "description_key": "[PassiveSkillDescription1500042]",
          "descriptions": {
            "zh-CN": "战斗开始时，佛罗伦斯额外减少10%自身承受伤害，使自己增加20%最大生命值（无法被解除）。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "バトル開始時、さらに自身の被ダメージが20%減少し、最大HPが40%増加する（解除不可）。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 221,
          "description_key": "[PassiveSkillDescription1500043]",
          "descriptions": {
            "zh-CN": "当生命值恢复目标原本的生命值为50%以上，且身上附带控制效果时，额外解除目标身上的所有控制效果。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "さらにHP回復の前にHP回復の対象のHP割合が50%以上で、行動阻害を付帯している場合、HP回復の対象の行動阻害を全て解除する。"
          }
        },

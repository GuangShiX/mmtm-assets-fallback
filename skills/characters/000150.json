      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 1,
          "description_key": "[ActiveSkillDescription1500011]",
          "descriptions": {
            "zh-CN": "“一起赢下这场战斗！”佛罗伦斯使生命值百分比最低的友军恢复佛罗伦斯攻击力×5%的生命值。“这就是我的觉悟！”再随机对敌人进行2次攻击，每次造成攻击力×520%的物理伤害。第7回合起，发动此技能不会恢复生命值，造成的物理伤害提升为攻击力×1040%。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "「みんなで勝つぞ！」HP割合が最も低い味方のHPを自身の攻撃力×5%回復する。「これが私の覚悟だ！」その後ランダムな敵に2回攻撃力×520%の物理攻撃を行う。このスキルを7ターン目以降に発動した場合、このスキルの味方のHPを回復する効果は発動せず、物理攻撃のダメージが攻撃力×1040%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 81,
          "description_key": "[ActiveSkillDescription1500012]",
          "descriptions": {
            "zh-CN": "生命值恢复量提升为佛罗伦斯攻击力×15%。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "HPの回復量が自身の攻撃力×15%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription1500013]",
          "descriptions": {
            "zh-CN": "造成的物理伤害提升为攻击力×890%。第7回合起，造成的物理伤害提升为攻击力×1780%。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {

  "passive_skills": [
    {
      "id": 117003,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription1170031]",
          "descriptions": {
            "zh-CN": "博士为了让我延续生命而给我的诅咒之力，至今还散发着微弱的光芒守护我。战斗开始时，A.A.使攻击力最高的3名友军获得「沉默免疫」，效果持续1回合。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "私の命を延ばす為に、博士がくれた呪いの力は、今もかすかな光で私を守っている。バトル開始時攻撃力が高い味方3体に1ターンの間『沈黙無効』を付与する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[PassiveSkillDescription1170032]",
          "descriptions": {
            "zh-CN": "第1、11、21、31回合开始时，A.A.使攻击力最高的友军额外获得「护盾」，「护盾」值为状态效果生效前的附加目标最大生命值×30%，效果持续1回合（无法被解除）。失去战斗能力仍可触发「护盾」附加效果。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "さらに1、11、21、31ターン目のターン開始時攻撃力が最も高い味方に、1ターンの間ステータス増減前の対象の最大HP×30%の『シールド』を付与する（解除不可）。『シールド』を付与する効果は自身が戦闘不能の場合でも発動する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription1170033]",
          "descriptions": {
            "zh-CN": "如果队伍中属性相同的友军达3名以上，「护盾」的附加目标增加为攻击力最高的3名友军。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "さらに味方編成内で同じ属性の味方の編成数が3体以上の場合、『シールド』を付与する対象が攻撃力が高い味方3体になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 240,
          "description_key": "[PassiveSkillDescription1170034]",
          "descriptions": {
            "zh-CN": "强化天使余晖，「护盾」值提升为状态效果生效前的附加目标最大生命值×100%。"
          },
          "equipment_rarity_flags": 256,
          "order": 4,
          "source_memo_ja": {
            "label": "Ex2",
            "text": "天使の残光を強化する。『シールド』の大きさがステータス増減前の対象の最大HP×100%になる。"
          }
        }
      ],

  "passive_skills": [
    {
      "id": 77003,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription770031]",
          "descriptions": {
            "zh-CN": "“消除气息的方法？这个很简单啊！”如何隐藏气息、消除声音——她所传授的方法，就像一头盯上猎物的野兽。战斗开始时，米娜修玛力使自己与攻击力最高的其他友军获得「隐身」状态，效果持续1回合（无法被解除）。当米娜修玛力受到攻击，生命值降到50%以下或失去战斗能力时，解除此技能附加的「隐身」状态。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "バトル開始時自身と自身以外の攻撃力が最も高い味方に1ターンの間『ステルス』を付与する（解除不可）。自身が攻撃を受けて、自身のHP割合が50%以下になった場合、もしくは自身が戦闘不能になったとき、このスキルで付与した自身と味方の『ステルス』を解除する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[PassiveSkillDescription770032]",
          "descriptions": {
            "zh-CN": "「隐身」效果增加为2回合。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "『ステルス』のターン数が2ターンになる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription770033]",
          "descriptions": {
            "zh-CN": "当米娜修玛力受到攻击，生命值降到50%以下时，获得1层「多重屏障」（无法被解除）。当她受到最大生命值×10%以上的伤害时，消耗1层屏障来抵消该伤害。此技能须在结束4次行动后才可再次触发。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "自身が攻撃を受けて、自身のHP割合が50%以下になった場合、さらに自身に1層の『多重バリア』を付与する（解除不可）。自身の最大HP×10%以上のダメージを受けると、バリアを1層消費してそのダメージを無効化する。この効果は4ターンに1回発動する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 240,
          "description_key": "[PassiveSkillDescription770034]",
          "descriptions": {
            "zh-CN": "强化热心的小狐狸，「多重屏障」增加为3层。"
          },
          "equipment_rarity_flags": 256,
          "order": 4,
          "source_memo_ja": {
            "label": "Ex2",
            "text": "スキル3を強化する。『多重バリア』が3層になる。"
          }
        }
      ],

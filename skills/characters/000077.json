      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 61,
          "description_key": "[PassiveSkillDescription770041]",
          "descriptions": {
            "zh-CN": "每当有人在面前倒下，就会唤醒当时的记忆，激起她心中强烈的悲愤之情。每当1名友军失去战斗能力，米娜修玛力使自己增加30%攻击力（最多叠加2层，合计60%）（无法被解除）。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "自身以外の味方が戦闘不能になったとき、戦闘不能になった味方の数1体につき自身の攻撃力が30%増加する（合計で最大60%まで）（解除不可）。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 141,
          "description_key": "[PassiveSkillDescription770042]",
          "descriptions": {
            "zh-CN": "友军失去战斗能力时的攻击力增幅提升为40%（最多叠加2层，合计80%）。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "自身以外の味方が戦闘不能になったときに上昇する攻撃力の増加量が40%になる（合計で最大80%まで）。"
          }

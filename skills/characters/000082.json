      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 11,
          "description_key": "[ActiveSkillDescription820021]",
          "descriptions": {
            "zh-CN": "“胆敢与教皇陛下为敌者，一律就地正法！”亚历珊卓向强敌发动猛烈攻势，对攻击力最高的敌人进行4次攻击，每次造成攻击力×320%的物理伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "「教皇様に仇なす敵は、ここで討ち滅ぼす！」強敵に狙いを定め、一気に畳みかける――攻撃力が最も高い敵に4回攻撃力×320%の物理攻撃を行う。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 21,
          "description_key": "[ActiveSkillDescription820022]",
          "descriptions": {
            "zh-CN": "攻击次数增加为5次。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "物理攻撃の回数が5回になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 101,
          "description_key": "[ActiveSkillDescription820023]",
          "descriptions": {
            "zh-CN": "当亚历珊卓身上附带「守护骑士」状态时，攻击次数增加为10次。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "さらに物理攻撃の前に自身が『守護騎士』を付帯している場合、物理攻撃の回数が10回になる。"
          }
        },
        {

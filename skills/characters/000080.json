  "passive_skills": [
    {
      "id": 80003,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription800031]",
          "descriptions": {
            "zh-CN": "“饿肚子真的很可怕，所以要随时保持八分饱！不然那个声音可能又要出现了……”战斗开始时，蜜拉使其他友军增加10%最大生命值（无法被解除）。当技能目标为苍翠属性时，额外增加最大生命值，增幅为状态效果生效前的蜜拉攻击力×100%。再使自己增加状态效果生效前的攻击力×200%的最大生命值（无法被解除）。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "空腹は本当に恐ろしい。だから常に腹八分目以上にしておこう！　そうしないと、またあの囁きが聞こえてくるかも知れないから──バトル開始時自身以外の味方全体の最大HPを10%増加させる（解除不可）。対象が翠属性の場合、最大HPの増加量がさらにステータス増減前の付与者自身の攻撃力×100%分大きくなる。その後自身の最大HPがステータス増減前の付与者自身の攻撃力×200%分増加する（解除不可）。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[PassiveSkillDescription800032]",
          "descriptions": {
            "zh-CN": "蜜拉的最大生命值增幅提升为状态效果生效前的攻击力×500%。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "自身の最大HPの増加量がステータス増減前の付与者自身の攻撃力×500%分になる。"
          }
        },
        {
          "blessing_item_id": 0,

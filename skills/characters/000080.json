      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 1,
          "description_key": "[ActiveSkillDescription800011]",
          "descriptions": {
            "zh-CN": "蜜拉拨动琴弦，伴着旋律唱出誓不放弃的决心，随机对2名敌人造成攻击力×180%的魔法伤害，40%概率对技能目标附加「迟缓」状态，效果持续1回合，降低技能冷却时间恢复速度1，延缓再度发动技能的时间。「迟缓」附加判定结束后，再使自己恢复5%最大生命值。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "弦を爪弾き歌うは、決して諦めないという誓いとそれに込められた願い。ランダムな敵2体に攻撃力×180%の魔法攻撃を行い、40%の確率で1ターンの間対象に『遅延』を付与する。毎ターン行動終了時にスキルクールタイムの減少を1遅らせ、次回のスキル発動が遅くなる。『遅延』付与の判定の後、自身のHPを自身の最大HP×5%回復する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 81,
          "description_key": "[ActiveSkillDescription800012]",
          "descriptions": {
            "zh-CN": "附加「迟缓」状态的概率提升为70%。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "『遅延』を付与する確率が70%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription800013]",
          "descriptions": {
            "zh-CN": "生命值恢复量提升为10%最大生命值。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "HPの回復量が自身の最大HP×10%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription800014]",
          "descriptions": {
            "zh-CN": "强化决意回旋曲，攻击目标增加为3名随机敌人。"
          },
          "equipment_rarity_flags": 128,
          "order": 4,
          "source_memo_ja": {
            "label": "Ex1",
            "text": "決意のロンドを強化する。魔法攻撃の対象がランダムな敵3体になる。"
          }
        }
      ],

      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 1,
          "description_key": "[ActiveSkillDescription990011]",
          "descriptions": {
            "zh-CN": "“谁都别想伤害我的妹妹。就算我不在世上了，这条缎带也会继续守护她……！”莉莉珂特使自己受到2次当前生命值×20%的自损伤害，70%概率解除附带增益效果最多的敌人身上的2种增益效果。再随机对敌人进行4次攻击，每次造成攻击力×430%的物理伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "「私の妹を傷つけさせない。私が消えた後も、どうかあの子を守って……！」自身に2回自身の現在HP×20%の自傷ダメージを与え、70%の確率で付帯しているバフの個数が最も多い敵のバフを2つ解除する。その後ランダムな敵に4回攻撃力×430%の物理攻撃を行う。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 81,
          "description_key": "[ActiveSkillDescription990012]",
          "descriptions": {
            "zh-CN": "造成的物理伤害提升为攻击力×580%。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "物理攻撃のダメージが攻撃力×580%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription990013]",
          "descriptions": {
            "zh-CN": "攻击次数增加为6次。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "物理攻撃の回数が6回になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 161,
          "description_key": "[ActiveSkillDescription990014]",
          "descriptions": {
            "zh-CN": "强化约定所系的缎带，当队伍中的其他业红属性友军数为3名以上时，解除的增益效果增加为6种。"
          },
          "equipment_rarity_flags": 128,
          "order": 4,
          "source_memo_ja": {
            "label": "Ex1",
            "text": "誓い結うリボンを強化する。さらに自身以外の紅属性の味方の編成数が3体以上の場合、バフの解除数が6になる。"
          }
        },
        {

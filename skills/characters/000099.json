      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription990031]",
          "descriptions": {
            "zh-CN": "“但愿我们的爱，能成为你永远的后盾。”解除敌人身上的增益效果后，莉莉珂特使自己与攻击力最高的其他友军增加攻击力与防御力，增幅分别为莉莉珂特攻击力×20%及莉莉珂特防御力×20%，效果持续1回合（无法被解除）。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "「私たちの愛が、どうかいつまでも貴女の支えとなりますように」自身が敵のバフを解除したとき、1ターンの間自身と自身以外の攻撃力が最も高い味方の攻撃力を自身の攻撃力×20%、防御力を自身の防御力×20%増加させる（解除不可）。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[PassiveSkillDescription990032]",
          "descriptions": {
            "zh-CN": "「攻击力上升」与「防御力上升」效果增加为2回合。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "『攻撃力増加』と『防御力増加』のターン数が2ターンになる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription990033]",
          "descriptions": {
            "zh-CN": "当技能目标为业红属性时，攻击力与防御力增幅分别提升为莉莉珂特攻击力×50%及莉莉珂特防御力×50%。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "さらに対象が紅属性の場合、攻撃力の増加量が自身の攻撃力×50%、防御力の増加量が自身の防御力×50%になる。"
          }
        }
      ],

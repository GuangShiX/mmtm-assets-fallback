          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "攻撃力の増加量が30％になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription1210033]",
          "descriptions": {
            "zh-CN": "如果璐米佳在本回合内使攻击目标失去战斗能力，在回合结束时使自己额外减少技能冷却时间1。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {

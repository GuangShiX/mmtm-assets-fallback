  "passive_skills": [
    {
      "id": 86003,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription860031]",
          "descriptions": {
            "ja-JP": "中身のない抜け殻となっても、その種は自らを守ろうと今もうごめいている。自身が攻撃して、対象を戦闘不能にできなかった場合、自身に1層の『多重バリア』を付与する（最大3層まで）（解除不可）。自身の最大HP×10%以上のダメージを受けると、バリアを1層消費してそのダメージを無効化する。",
            "zh-CN": "即便只剩下里面空无一物的残骸，那颗种子仍然保有求生的意欲，至今仍在玫莉亚的体内蠢动。玫莉亚发动攻击后，如果攻击目标仍然存活，玫莉亚获得1层「多重屏障」（最多3层）（无法被解除）。当她受到最大生命值×10%以上的伤害时，消耗1层屏障来抵消该伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "中身のない抜け殻となっても、その種は自らを守ろうと今もうごめいている。自身が攻撃して、対象を戦闘不能にできなかった場合、自身に1層の『多重バリア』を付与する（最大3層まで）（解除不可）。自身の最大HP×10％以上のダメージを受けると、バリアを1層消費してそのダメージを無効化する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[PassiveSkillDescription860032]",
          "descriptions": {
            "ja-JP": "『多重バリア』の最大層数が4層になる。",
            "zh-CN": "「多重屏障」的层数上限增加为4层。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "『多重バリア』の最大層数が4層になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription860033]",
          "descriptions": {
            "ja-JP": "さらに自身がこのスキルで付与した『多重バリア』を4層付帯している状態で新しく付与が行われる場合、『多重バリア』付与の対象が自身以外の攻撃力が最も高い味方になる。",
            "zh-CN": "当玫莉亚身上附带4层此技能附加的「多重屏障」时，新的「多重屏障」附加对象改为攻击力最高的其他友军。"
          },
          "equipment_rarity_flags": 0,

  "passive_skills": [
    {
      "id": 92003,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription920031]",
          "descriptions": {
            "zh-CN": "过去只会吞噬生命的拟花，如今已能将生命转化为力量，并回馈到其他人身上。这点小小的变化，正是艾蒂涅有所成长的证明。当艾蒂涅或友军发动主动技能触发恢复生命值的效果时，艾蒂涅使自己与攻击力最高的其他友军获得1层「茁花」（最多15层）（无法被解除）。每层「茁花」使附带者增加5%攻击力与1%伤害反弹。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "かつて命を呑むだけの花もどきは、命を力に換えて、他者へ還すまでに至った。それは少女の変化を示す、ささやかな証でもある。自身か味方のアクティブスキルがHPを回復する効果を発動したとき、自身と自身以外の攻撃力が最も高い味方に『旺花』を1スタック付与する（最大15スタックまで）（解除不可）。このバフは1スタックにつき付帯者の攻撃力を5%、カウンタを1%増加させる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[PassiveSkillDescription920032]",
          "descriptions": {
            "zh-CN": "当「茁花」的附加目标为苍翠属性时，伤害反弹增幅额外提升为2%。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "『旺花』を付与する対象が翠属性の場合、カウンタの増加量が2%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription920033]",
          "descriptions": {
            "zh-CN": "「茁花」的附加目标增加为艾蒂涅与攻击力最高的2名其他友军。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "『旺花』を付与する対象が自身と自身以外の攻撃力が高い味方2体になる。"
          }
        }
      ],

          "description_key": "[ActiveSkillDescription1410021]",
          "descriptions": {
            "zh-CN": "当构筑万物的原理崩解时，一切都将重新分解为比砂粒更微小的元素。百合随机对敌人进行6次攻击，每次造成攻击力×160%的魔法伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "万物を形作る理を解いた時、砂粒にも満たない元素へ還る。ランダムな敵に6回攻撃力×160%の魔法攻撃を行う。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 21,
          "description_key": "[ActiveSkillDescription1410022]",
          "descriptions": {
            "zh-CN": "发动攻击前，使技能目标额外减少40%回血量，效果持续4回合。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "さらに魔法攻撃の前に4ターンの間対象の被回復量を40%減少させる。"

  "passive_skills": [
    {
      "id": 66003,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription660031]",
          "descriptions": {
            "zh-CN": "我只希望能够待在需要我的人身边、成为对方的后盾——战斗开始时，艾莉丝获得「结界」，效果持续2回合。当此增益效果的附带者受到攻击，承受伤害超过最大生命值的20%时，阻绝超量部分×50%的伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "自分を必要としてくれる人の傍で、その人を支えること。欲しいのはたったそれだけだった。バトル開始時2ターンの間自身に『結界』を付与する。このバフを付帯したキャラが最大HP×20%を超えるダメージの攻撃を受けた場合、最大HP×20%を超えた分のダメージを50%遮断する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[PassiveSkillDescription660032]",
          "descriptions": {
            "zh-CN": "使攻击力最高的其他友军额外获得「结界」。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "さらに自身以外の攻撃力が最も高い味方にも『結界』を付与する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription660033]",
          "descriptions": {
            "zh-CN": "使速度最高的其他友军额外获得「结界」（技能目标与攻击力最高的其他友军重复时，重复附加的新「结界」将直接取代旧「结界」）。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "さらに自身以外のスピードが最も高い味方にも『結界』を付与する（付与する対象が攻撃力が最も高い味方と同一である場合、このスキルによる『結界』は重ね掛けの効果により上書きされ、自身とその味方の2体にのみ付与される）。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 181,
          "description_key": "[PassiveSkillDescription660034]",
          "descriptions": {
            "zh-CN": "强化未果之情，「结界」的伤害阻绝量提升为70%。"
          },
          "equipment_rarity_flags": 256,
          "order": 4,
          "source_memo_ja": {
            "label": "Ex2",
            "text": "零れ落ちた想いを強化する。このバフを付帯したキャラが最大HP×20%を超えるダメージの攻撃を受けた場合、最大HP×20%を超えた分のダメージを70%遮断するようになる。"
          }
        }
      ],

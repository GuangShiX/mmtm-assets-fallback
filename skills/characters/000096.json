    {
      "conditions": "True",
      "id": 96002,
      "initial_cooldown": 0,
      "kind": "active",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 11,
          "description_key": "[ActiveSkillDescription960021]",
          "descriptions": {
            "zh-CN": "阿姆蕾特华丽的剑术有如穿透黑暗的星光，将敌人一举击溃，对攻击力最高的敌人进行4次攻击，每次造成攻击力×520%的物理伤害。每次攻击之后，30%概率随机对敌人追加攻击力×520%的物理伤害（最多4次）。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "闇を穿つ星の火のように、華麗な剣技で敵を討ち倒す。攻撃力が最も高い敵に4回攻撃力×520%の物理攻撃を行う。攻撃するたび30%の確率でランダムな敵に攻撃力×520%の物理攻撃を行う。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 21,
          "description_key": "[ActiveSkillDescription960022]",
          "descriptions": {
            "zh-CN": "发动追加攻击的概率提升为50%。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "追加攻撃の確率が50%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 101,
          "description_key": "[ActiveSkillDescription960023]",
          "descriptions": {
            "zh-CN": "在追加攻击发动判定前，如果阿姆蕾特的生命值为50%以下，发动追加攻击的概率提升为100%。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "追加攻撃の判定の前に、自身のHP割合が50%以下の場合、追加攻撃の確率が100%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 181,
          "description_key": "[ActiveSkillDescription960024]",
          "descriptions": {
            "zh-CN": "战斗中自第3次发动此技能起，第一波攻击与追加攻击造成的物理伤害提升为攻击力×780%。"
          },
          "equipment_rarity_flags": 0,
          "order": 4,
          "source_memo_ja": {
            "label": "Lv4",
            "text": "バトル中このスキルを使うのが3回目以降の場合、最初の物理攻撃と追加攻撃のダメージがそれぞれ攻撃力×780%になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 240,
          "description_key": "[ActiveSkillDescription960025]",
          "descriptions": {
            "zh-CN": "强化星辉，揭开喜剧的序幕，第一波攻击与追加攻击造成的物理伤害提升为攻击力×580%。战斗中自第3次发动此技能起，第一波攻击与追加攻击造成的物理伤害提升为攻击力×870%。"
          },
          "equipment_rarity_flags": 512,
          "order": 5,
          "source_memo_ja": {
            "label": "Ex3",
            "text": "星によりて幕は上がるを強化する。最初の物理攻撃と追加攻撃のダメージがそれぞれ攻撃力×580%になる。バトル中このスキルを使うのが3回目以降の場合、最初の物理攻撃と追加攻撃のダメージがそれぞれ攻撃力×870%になる。"
          }
        }
      ],

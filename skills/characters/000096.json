    {
      "id": 96004,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 61,
          "description_key": "[PassiveSkillDescription960041]",
          "descriptions": {
            "zh-CN": "阿姆蕾特以坚定的意志贯彻女王的职责，当她受到致命伤害时，保留1点生命值不死，并获得增益效果「王者意志」，使自己减少90%攻击力并获得「不死之身」效果，效果持续10回合（无法被解除）。保留1点生命值不死与「王者意志」须在结束8次行动后才可再次触发。自第17回合起无法触发此技能。当阿姆蕾特受到攻击，生命值降为1时，身上附带的「王者意志」效果减少1回合。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "王の責務を果たすという固い決意で、自身が致命的なダメージを受けたとき、HP1で耐える。その後10ターンの間自身に『王の覚悟』を付与する（解除不可）。このバフは自身の攻撃力を90%減少させ、『不死身』の効果を持つ。HP1で耐える効果と『王の覚悟』の付与は、発動後8ターン経過するまで発動せず、17ターン目以降は発動しない。自身が攻撃を受けて、自身のHPが1の場合、自身が付帯している『王の覚悟』のターン数が1減少する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 141,
          "description_key": "[PassiveSkillDescription960042]",
          "descriptions": {
            "zh-CN": "第7回合起触发的「王者意志」不会减少攻击力。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "『王の覚悟』の付与を7ターン目以降に発動した場合、攻撃力が減少しなくなる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 221,
          "description_key": "[PassiveSkillDescription960043]",
          "descriptions": {
            "zh-CN": "当阿姆蕾特受到攻击，生命值降为1时，身上附带的「王者意志」效果减少1回合，并使阿姆蕾特恢复10%最大生命值。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "自身が攻撃を受けて、自身のHPが1の場合、『王の覚悟』のターン数減少の後、さらに自身のHPを自身の最大HP×10%回復する。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 240,
          "description_key": "[PassiveSkillDescription960044]",
          "descriptions": {
            "zh-CN": "强化王者意志，保留1点生命值不死与「王者意志」须在结束4次行动后才可再次触发。自第33回合起无法触发此技能。"
          },
          "equipment_rarity_flags": 256,

  "passive_skills": [
    {
      "id": 112003,
      "kind": "passive",
      "levels": [
        {
          "blessing_item_id": 0,
          "character_level": 41,
          "description_key": "[PassiveSkillDescription1120031]",
          "descriptions": {
            "zh-CN": "立定时宁静如照亮黑夜的月光。静调息凝神——集中力量于一点之上。战斗开始时，使自己增加攻击力，增幅为状态效果生效前的静防御力×100%（无法被解除）。"
          },
          "equipment_rarity_flags": 0,
          "order": 1,
          "source_memo_ja": {
            "label": "Lv1",
            "text": "夜を照らす月光の如く佇む。呼吸を整え、心を静め――力を一点に集中させる。バトル開始時自身の攻撃力が、ステータス増減前の自身の防御力×100%分増加する（解除不可）。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 121,
          "description_key": "[PassiveSkillDescription1120032]",
          "descriptions": {
            "zh-CN": "攻击力增幅提升为状态效果生效前的静防御力×200%。"
          },
          "equipment_rarity_flags": 0,
          "order": 2,
          "source_memo_ja": {
            "label": "Lv2",
            "text": "攻撃力の増加量がステータス増減前の自身の防御力×200%分になる。"
          }
        },
        {
          "blessing_item_id": 0,
          "character_level": 201,
          "description_key": "[PassiveSkillDescription1120033]",
          "descriptions": {
            "zh-CN": "战斗开始时，静额外获得1层「多重屏障」（无法被解除）。当静受到最大生命值×20%以上的伤害时，消耗1层屏障来抵消该伤害。"
          },
          "equipment_rarity_flags": 0,
          "order": 3,
          "source_memo_ja": {
            "label": "Lv3",
            "text": "さらにバトル開始時自身に1層の『多重バリア』を付与する（解除不可）。自身の最大HP×20％以上のダメージを受けると、バリアを1層消費してそのダメージを無効化する。"
          }
        }
      ],
